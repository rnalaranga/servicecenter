# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="mysql://root:password@localhost:3306/auto_elevate_erp"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# App
APP_NAME="AUTO ELEVATE ERP"
DEFAULT_CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Dev Admin Password
DEV_ADMIN_PASSWORD=admin@autoelevate123
